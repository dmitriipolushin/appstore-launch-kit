# ASO Tools — конфиг ключей
# Скопировать в ~/.config/aso-tools/api_keys.env и заполнить.
# Нужен только для skills/aso-collection. Остальные части репозитория ключей не требуют.

# --- AppStoreSpy: профили конкурентов, subtitle, downloads/revenue ---
# Обязателен для: collect_profiles.py, поиска конкурентов
# Без него: subtitle конкурентов недоступен (iTunes API его не возвращает)
APPSTORESPY_API_KEY=

# --- Apple Search Ads: Search Popularity ключевых слов (0–100) ---
# Cookie-based, живёт ~24 часа. Процедура получения — в
# skills/aso-collection/SKILL.md, шаг 4В.
# Без него: реальный объём запросов неизвестен, только порядок Apple Search Hints
APPLE_SA_COOKIE=
APPLE_SA_XSRF=
APPLE_SA_ADAM_ID=
APPLE_SA_ADGROUP_ID=

# --- Apple Search Ads API (org-level, опционально) ---
ASA_ORG_ID=
ASA_CLIENT_ID=SEARCHADS.xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
ASA_KEY_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# --- App Store Connect API: заливка метаданных и метрики ---
# App Store Connect → Users and Access → Integrations → App Store Connect API
# .p8 файл кладётся в ~/.config/aso-tools/keys/AuthKey_{ASC_KEY_ID}.p8
ASC_KEY_ID=
ASC_ISSUER_ID=

# --- AppFollow (опционально) ---
APPFOLLOW_API_TOKEN=
APPFOLLOW_BASE_URL=https://api.appfollow.io/api/v2
