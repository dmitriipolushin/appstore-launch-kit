# ASO Tools — конфиг ключей
# Скопировать в ~/.config/aso-tools/api_keys.env и заполнить.
# Нужен для aso-collection, aso-monitoring, asc-metadata и ASA-скиллов
# (asa-launch, asa-monitoring). Скриншоты, app-store-optimization и методология
# работают без ключей. Заполняй только то, что нужно под твою задачу.

# --- AppStoreSpy: анализ чужих приложений в сторе ---
# Обязателен для: shared/appstorespy_cli.py (subtitle конкурентов, похожие
# приложения, оценки загрузок и выручки, позиции в топ-чартах, разработчики)
# и для обогащения профилей в collect_profiles.py.
# Без него: subtitle конкурентов недоступен (iTunes API его не возвращает),
# конкурентный анализ ограничен открытыми данными iTunes.
# Справочник команд: knowledge/appstorespy_api.md
APPSTORESPY_API_KEY=

# --- Apple Ads API: ASA-скиллы и официальная Search Popularity ---
# Обязателен для: asa-launch, asa-monitoring (кампании, ставки, отчёты) и
# shared/asa/platform_api.py --popularity (частые запросы по стране и жанру).
# Apple Ads → Account Settings → API. Приватный ключ кладётся в
# ~/.config/aso-tools/keys/apple_ads_private_key.pem (публичная половина загружена в Apple Ads).
# ASA_ORG_ID: platform_api.py подберёт сам, если аккаунт у ключа один;
# скрипты API v5 (asa_api.py) требуют его явно.
ASA_ORG_ID=
ASA_CLIENT_ID=SEARCHADS.xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
ASA_KEY_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# --- Apple Ads: Search Popularity длинного хвоста (cookie-способ) ---
# Cookie из DevTools на app-ads.apple.com, живёт ~24 часа. Процедура — в
# skills/aso-collection/SKILL.md, шаг 4В. ADAM_ID — App Store ID ТВОЕГО
# приложения из той же ниши (данные отдаются только по своим приложениям).
# Без него: объём редких запросов неизвестен, только порядок Apple Search Hints
APPLE_SA_COOKIE=
APPLE_SA_XSRF=
APPLE_SA_ADAM_ID=

# --- App Store Connect API: заливка метаданных и метрики ---
# App Store Connect → Users and Access → Integrations → App Store Connect API
# .p8 файл кладётся в ~/.config/aso-tools/keys/AuthKey_{ASC_KEY_ID}.p8
ASC_KEY_ID=
ASC_ISSUER_ID=

# --- AppFollow (опционально) ---
APPFOLLOW_API_TOKEN=
APPFOLLOW_BASE_URL=https://api.appfollow.io/api/v2
